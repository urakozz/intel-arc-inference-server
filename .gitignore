# ---- Build output ----------------------------------------------------------
build/
cmake-build-*/
out/
install/

# CMake droppings if anyone configures in-tree
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
Makefile
compile_commands.json
.ninja_deps
.ninja_log
build.ninja

# ---- Compiled artefacts ----------------------------------------------------
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.d
*.gch
*.pch

# ---- SYCL / oneAPI / Level Zero --------------------------------------------
# Offline-compiled device code: ocloc output, SPIR-V, LLVM IR, AOT blobs.
# All regenerable from source; some are large.
*.spv
*.spirv
*.ll
*.bc
*.gen
*.ocloc
*.dev.o
*.fatbin
# icpx integration headers / temporaries
*.integration.h
*.integration.cpp
# SYCL JIT + Level Zero on-disk caches
.neo_cache/
.cl_cache/
.syclcache/

# ---- Model weights and converted artefacts ---------------------------------
# Never commit weights. The canonical repacked layout produced by tools/ is a
# build product of a checkpoint - regenerate it, do not track it.
*.safetensors
# ...except small committed test fixtures (gitignore has no inline comments).
!tests/golden/*.safetensors
*.gguf
*.pt
*.pth
*.onnx
*.npy
*.npz
weights/
models/
artifacts/
data/

# ---- Measurements ----------------------------------------------------------
# Numbers that matter belong in docs/ with their method written down,
# not as untracked raw dumps.
*.log
*.nsys-rep
*.sqlite
prof/
traces/
bench-out/
# Oracle golden dumps: hundreds of MB per prompt, produced on the box by
# tools/oracle/dump.py and never committed (tools/box.sh excludes them from sync).
oracle-out/
oracle-out-*/

# ---- Python tooling (tools/ only) ------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- IDE -------------------------------------------------------------------
.idea/
.vscode/
*.iml
.cache/
.clangd/

# ---- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---- Local, do not share ---------------------------------------------------
.env
*.local
local.*
# Machine address for the remote build/bench helpers. Copy box.env.example.
tools/box.env
# A .git moved aside before a history rewrite. Never part of the tree: the old
# packs still hold everything a rewrite was meant to remove.
.git.pre-rewrite-*

# ---- Agent scaffolding -----------------------------------------------------
# Session notes and per-plan working files from the agent harness. Useful while
# a change is in flight, noise afterwards. The designs that matter live in
# docs/specs/.
.superpowers/
.claude/
