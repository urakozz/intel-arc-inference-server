# Copy to .env in the main checkout's root (git-ignored; every worktree reads that one file) and edit.
# Sourced by the box helpers (tools/box.sh, bench_decode.sh, serve_bench.sh, box_validate.sh, ...) through
# tools/box_env.sh. An environment variable of the same name wins over anything set here.

# ssh target for the machine that has the GPUs.
BOX=user@host

# Path of the tree on that machine, relative to $HOME. Leave unset to derive it
# from the branch (tools/box_dir.sh: spec7a-* -> b70/trees/spec7a, main -> the
# base tree b70-inference-server).
# REMOTE_DIR=b70/trees/spec7a

# Parallelism for the remote build.
# JOBS=44
