    {"name": "tool_call_history", "tools": ["read"], "kwargs": {},
     "messages": [
       {"role": "user", "content": "Open src/main.cc."},
       {"role": "assistant", "content": "", "tool_calls": [
         {"id": "call_1", "type": "function", "function": {"name": "read", "arguments": {"filePath": "/work/src/main.cc", "offset": 12}}}]},
       {"role": "tool", "tool_call_id": "call_1", "content": "12\tint main() { return 0; }"},
       {"role": "user", "content": "Is it correct?"}]},
    {"name": "tool_response", "tools": ["read", "bash"], "kwargs": {},
     "messages": [
       {"role": "user", "content": "Run the loader tests and show the CMake file."},
       {"role": "assistant", "content": "Running both.", "reasoning_content": "Two independent calls; issue them together.", "tool_calls": [
         {"id": "call_a", "type": "function", "function": {"name": "bash", "arguments": {"command": "ctest -R loader", "description": "Run the loader tests"}}},
         {"id": "call_b", "type": "function", "function": {"name": "read", "arguments": {"filePath": "/work/CMakeLists.txt"}}}]},
       {"role": "tool", "tool_call_id": "call_a", "content": "5 passed, 0 failed"},
       {"role": "tool", "tool_call_id": "call_b", "content": [{"type": "text", "text": "1\tcmake_minimum_required(VERSION 3.20)"}, {"type": "text", "text": "2\tproject(b70)"}]}]},
    {"name": "calls_json", "tools": ["read", "edit"], "kwargs": {"tool_call_format": "json"},
     "messages": [
       {"role": "user", "content": "Fix the typo in README.md."},
       {"role": "assistant", "content": "", "reasoning_content": "Edit it.", "tool_calls": [
         {"id": "call_1", "type": "function", "function": {"name": "edit", "arguments": {"filePath": "/work/README.md", "oldString": "teh", "newString": "the", "replaceAll": true}}}]},
       {"role": "tool", "tool_call_id": "call_1", "content": "Edit applied."},
       {"role": "user", "content": "Now read lines 1-5."}]},
    {"name": "calls_xml_typed", "tools": ["read", "todowrite", "glob"], "kwargs": {"tool_call_format": "xml_typed"},
     "messages": [
       {"role": "user", "content": "Plan the work."},
       {"role": "assistant", "content": "", "reasoning_content": "Write the list, then look.", "tool_calls": [
         {"id": "call_1", "type": "function", "function": {"name": "todowrite", "arguments": {"todos": [{"content": "Read main.cc", "id": "1", "priority": "high", "status": "pending"}]}}},
         {"id": "call_2", "type": "function", "function": {"name": "read", "arguments": {"filePath": "/work/main.cc", "limit": 40}}},
         {"id": "call_3", "type": "function", "function": {"name": "glob", "arguments": {"pattern": "**/*.cc", "path": null}}}]},
       {"role": "tool", "tool_call_id": "call_1", "content": "ok"},
       {"role": "tool", "tool_call_id": "call_2", "content": "1\t#include <cstdio>"},
       {"role": "tool", "tool_call_id": "call_3", "content": "main.cc"}]},
    {"name": "present_xml", "tools": ["read", "todowrite", "edit"], "kwargs": {"tool_presentation_format": "xml"},
     "messages": [
       {"role": "user", "content": "List the todo items."}]},
    {"name": "present_json", "tools": ["read", "edit"], "kwargs": {"tool_presentation_format": "json"},
     "messages": [
       {"role": "system", "content": "Answer in German."},
       {"role": "user", "content": "Lies die Datei."}]},
    {"name": "null_default", "tools": ["glob"], "kwargs": {},
     "messages": [
       {"role": "user", "content": "Find the CMake files."}]},
    {"name": "schema_ref", "tools": ["patch"], "kwargs": {},
     "messages": [
       {"role": "user", "content": "Apply the edits."}]},
    {"name": "schema_ref_xml", "tools": ["patch", "glob"], "kwargs": {"tool_presentation_format": "xml"},
