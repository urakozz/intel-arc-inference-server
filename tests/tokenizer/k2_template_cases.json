       {"role": "user", "content": [{"type": "text", "text": "Explain RAII"}, {"type": "text", "text": " in one line."}]}]},
    {"name": "tools", "tools": ["read", "edit", "bash", "todowrite"], "kwargs": {},
     "messages": [
       {"role": "system", "content": "You are a coding agent working in /work."},
       {"role": "user", "content": "Open src/main.cc and tell me what it does."}]},
    {"name": "tools_no_system", "tools": ["read", "now"], "kwargs": {},
