# Copy to tools/box.env (untracked) and edit. Sourced by tools/box.sh,
# tools/bench_decode.sh and tools/serve_bench.sh. An environment variable of
# the same name wins over anything set here.

# ssh target for the machine that has the GPUs.
BOX=user@host

# Path of the tree on that machine, relative to $HOME. Leave unset to derive it
# from the branch (tools/box_dir.sh: spec7a-* -> b70-inference-server-spec7a).
# REMOTE_DIR=b70-inference-server

# Parallelism for the remote build.
# JOBS=44
